---
import { getCollection } from "astro:content";
import { withBase } from "../../lib/base";
import CreativeLayout from "../../layouts/CreativeLayout.astro";
import CreativeHeader from "../../components/creative/CreativeHeader.astro";
import CreativeFooter from "../../components/creative/CreativeFooter.astro";
import CreativeCta from "../../components/creative/CreativeCta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString("es-CL", { year: "numeric", month: "long", day: "numeric" });
---

<CreativeLayout
  title="Mirada Fi — Columnas y análisis | Agencia Fi"
  description="Desde nuestra experiencia periodística y estratégica, analizamos tendencias, decisiones y acontecimientos que impactan la reputación, la sostenibilidad y el desarrollo de las organizaciones."
>
  <CreativeHeader active="mirada" />

  <section class="cf-page-hero">
    <div class="cf-aurora">
      <div class="cf-blob cf-blob-1"></div>
      <div class="cf-blob cf-blob-2"></div>
    </div>
    <div class="cf-wrap" style="position:relative;z-index:2">
      <p class="cf-kicker cf-reveal">Mirada Fi</p>
      <h1 class="cf-h1-statement cf-h1-long cf-reveal cf-d1">
        Una mirada propia sobre las conversaciones que están <em>transformando el mundo empresarial.</em>
      </h1>
      <p class="cf-hero-lead cf-reveal cf-d2" style="max-width:60ch">
        Desde nuestra experiencia periodística y estratégica, analizamos tendencias,
        decisiones y acontecimientos que impactan la reputación, la sostenibilidad y
        el desarrollo de las organizaciones.
      </p>
      <p class="cf-hero-lead cf-reveal cf-d3" style="max-width:60ch;margin-top:1rem">
        Columnas, análisis de actualidad y reflexiones sobre los temas que importan
        al mundo empresarial.
      </p>
    </div>
  </section>

  <section class="cf-section" style="padding-top:1rem">
    <div class="cf-wrap">
      <div class="cf-grid3">
        {
          posts.map((post, i) => (
            <a href={withBase(`/mirada-fi/${post.id}`)} class={`cf-card cf-reveal cf-d${(i % 3) + 1}`}>
              {post.data.cover && (
                <div class="cf-card-img-wrap">
                  <img src={withBase(post.data.cover)} alt={post.data.title} loading="lazy" />
                </div>
              )}
              <div class="cf-card-body">
                <span class="cf-post-date">{fmt(post.data.pubDate)}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CreativeCta />
  <CreativeFooter />
</CreativeLayout>

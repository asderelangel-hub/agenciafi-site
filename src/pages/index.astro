---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import CreativeLayout from "../layouts/CreativeLayout.astro";
import CreativeHeader from "../components/creative/CreativeHeader.astro";
import CreativeFooter from "../components/creative/CreativeFooter.astro";
import CreativeCta from "../components/creative/CreativeCta.astro";
import { diferenciales, lineasServicio, formacionEjecutiva, luzVerde, pasos } from "../data/site";
import { img, icon } from "../lib/media";
import { withBase } from "../lib/base";

const heroPhoto = img("fotoequiponueva.png");
const bannerPhoto = img("banner-trabajo.png");
const simbolo = img("simbolo.png");

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const rest = posts.slice(1, 5);
const fmt = (d: Date) => d.toLocaleDateString("es-CL", { year: "numeric", month: "short", day: "numeric" });
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<CreativeLayout
  title="Agencia Fi — Comunicación estratégica, reputación y sostenibilidad"
  description="Ayudamos a empresas y organizaciones a comprender su entorno, construir confianza y fortalecer su posicionamiento. Comunicación estratégica, reputación y sostenibilidad."
>
  <CreativeHeader />

  <!-- 1. HERO -->
  <section class="cf-hero">
    <div class="cf-aurora">
      <div class="cf-blob cf-blob-1"></div>
      <div class="cf-blob cf-blob-2"></div>
      <div class="cf-blob cf-blob-3"></div>
    </div>
    <div class="cf-wrap cf-hero-inner">
      <div class="cf-hero-grid">
        <div>
          <p class="cf-kicker cf-reveal">Agencia de comunicaciones</p>
          <h1 class="cf-reveal cf-d1">
            La comunicación es la herramienta.
            <span class="cf-em">La reputación es el resultado.</span>
          </h1>
          <p class="cf-hero-lead cf-reveal cf-d2">
            Ayudamos a empresas y organizaciones a comprender su entorno, construir
            confianza y fortalecer su posicionamiento. Combinamos estrategia,
            experiencia periodística y conocimiento del negocio para transformar
            desafíos en oportunidades.
          </p>
          <div class="cf-hero-actions cf-reveal cf-d3">
            <a href="#servicios" class="cf-btn">Conoce lo que hacemos →</a>
          </div>
        </div>
        <div class="cf-hero-photo cf-reveal cf-d2">
          <div class="cf-hero-dots"></div>
          <div class="cf-photo-frame">
            <Image src={heroPhoto} alt="Equipo de Agencia Fi" width={760} height={570} />
            <div class="cf-photo-tint"></div>
          </div>
          <div class="cf-hero-badge"><img src={simbolo.src} alt="" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. NUESTRA FORMA DE TRABAJAR -->
  <section class="cf-section">
    <div class="cf-wrap">
      <div class="cf-split">
        <div class="cf-section-head cf-reveal" style="margin-bottom:0">
          <p class="cf-kicker">Nuestra forma de trabajar</p>
          <h2>No se trata solo de comunicar, sino que se trata de generar <em>confianza</em>.</h2>
        </div>
        <div class="cf-prose cf-reveal cf-d1">
          <p>
            En Agencia Fi creemos que una buena estrategia de comunicación comienza
            mucho antes de contar una historia. Comienza por entender el negocio,
            interpretar el contexto y reconocer los desafíos que enfrenta cada
            organización.
          </p>
          <p>
            Somos una consultora boutique de comunicaciones estratégicas, reputación
            y sostenibilidad. Trabajamos directamente con nuestros clientes,
            aportando experiencia, criterio periodístico y una mirada integral para
            construir relaciones de confianza con sus públicos.
          </p>
        </div>
      </div>

      <h3 class="cf-subhead cf-reveal">Qué nos diferencia</h3>
      <div class="cf-pilares">
        {
          diferenciales.map((d, i) => (
            <div class={`cf-pilar cf-reveal cf-d${i + 1}`}>
              <span class="cf-pilar-idx">{num(i)} / 03</span>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. BANNER OBSERVATORIO FI -->
  <section class="cf-photo-banner cf-banner-cta">
    <Image src={bannerPhoto} alt="" width={1600} height={760} />
    <div class="cf-banner-tint"></div>
    <div class="cf-banner-body cf-reveal">
      <p class="cf-kicker cf-kicker-light">Observatorio Fi</p>
      <h2>Estudiamos cómo cambian las empresas.</h2>
      <p>
        Investigamos las transformaciones que están redefiniendo el mundo
        empresarial chileno y sus implicancias para la reputación, la
        sostenibilidad y la comunicación de las organizaciones.
      </p>
      <a href={withBase("/observatorio-fi")} class="cf-btn cf-btn-accent">Explora el Observatorio Fi →</a>
    </div>
  </section>

  <!-- 4. SERVICIOS (acordeón) -->
  <section class="cf-section cf-section-soft" id="servicios">
    <div class="cf-wrap">
      <div class="cf-section-head cf-reveal" style="max-width:760px">
        <p class="cf-kicker">Servicios</p>
        <h2>Soluciones estratégicas para construir <em>reputación</em>, confianza y posicionamiento.</h2>
        <p>
          Combinamos distintas especialidades para diseñar respuestas a la medida
          de cada organización. Desde la estrategia hasta la implementación,
          acompañamos a nuestros clientes con criterio, experiencia y atención
          cercana.
        </p>
      </div>

      <div class="cf-acc-list">
        {
          lineasServicio.map((s, i) => (
            <details class="cf-acc cf-reveal">
              <summary>
                <span class="cf-acc-num">{num(i)}</span>
                <span class="cf-acc-head">
                  <span class="cf-acc-title">{s.titulo}</span>
                  <span class="cf-acc-lead">{s.bajada}</span>
                </span>
                <span class="cf-acc-icon" aria-hidden="true"></span>
              </summary>
              <div class="cf-acc-body">
                <p>{s.texto}</p>
                <ul>
                  {s.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            </details>
          ))
        }
      </div>

      <div class="cf-formacion cf-reveal">
        <div class="cf-bento-icon"><img src={icon("icon-chalkboard.svg")} alt="" /></div>
        <div>
          <h3>{formacionEjecutiva.titulo}</h3>
          {formacionEjecutiva.parrafos.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. BANNER AGENCIA FI + LUZ VERDE (con la identidad de Luz Verde) -->
  <section class="cf-luzverde" id="luz-verde">
    <video
      class="cf-lv-video"
      src={withBase("/video/luzverde.mp4")}
      poster={withBase("/video/luzverde-poster.webp")}
      muted
      playsinline
      preload="metadata"
      aria-label="Logo de Luz Verde"
    ></video>
    <!-- Líneas: corren bajo el texto y suben a unirse con las ondas del video -->
    <svg class="cf-lv-lines" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="cf-lv-grad" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#5cd6a0" stop-opacity="0.3" />
          <stop offset="0.55" stop-color="#5cd6a0" stop-opacity="0.8" />
          <stop offset="1" stop-color="#5cd677" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <path pathLength="1" d="M0,235 C300,250 520,232 700,165 S1000,45 1440,75" />
      <path pathLength="1" d="M0,252 C320,262 560,250 760,185 S1080,75 1440,125" />
      <path pathLength="1" d="M0,220 C280,234 600,222 820,148 S1200,25 1440,45" />
    </svg>
    <div class="cf-wrap cf-lv-inner">
      <div class="cf-lv-copy">
        <p class="cf-kicker cf-kicker-light cf-reveal">Agencia Fi + Luz Verde</p>
        <h2 class="cf-reveal cf-d1">Estrategia y contenidos que generan <em>conversación</em>.</h2>
        <div class="cf-prose cf-reveal cf-d2">
          <p>
            Nuestra alianza estratégica con <strong>Luz Verde</strong>, plataforma
            informativa especializada en inversión, sostenibilidad, infraestructura y
            desarrollo empresarial, amplía nuestras capacidades de posicionamiento.
          </p>
          <p>
            A través de su programa en <strong>Radio 13C</strong> y su presencia en
            YouTube, Spotify y redes sociales, Luz Verde conecta la actualidad
            empresarial con distintas audiencias.
          </p>
          <p>
            Juntos, combinamos comunicación estratégica y producción periodística para
            desarrollar <strong>coberturas de eventos, entrevistas, podcasts y
            contenidos audiovisuales</strong> que dan visibilidad a proyectos,
            organizaciones y líderes.
          </p>
          {
            luzVerde.url && (
              <a href={luzVerde.url} target="_blank" rel="noopener" class="cf-btn cf-lv-btn" style="margin-top:0.6rem">
                Conoce Luz Verde ↗
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CÓMO TRABAJAMOS -->
  <section class="cf-section cf-section-soft">
    <div class="cf-wrap">
      <div class="cf-section-head cf-reveal" style="text-align:center;margin:0 auto 3.5rem">
        <h2>Cómo <em>trabajamos</em></h2>
      </div>
      <ol class="cf-steps">
        {
          pasos.map((p, i) => (
            <li class={`cf-step cf-reveal cf-d${(i % 4) + 1}`}>
              <span class="cf-step-num">{num(i)}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 7. MIRADA FI (noticias) -->
  <section class="cf-section">
    <div class="cf-wrap">
      <div class="cf-section-head cf-reveal" style="display:flex;justify-content:space-between;align-items:flex-end;max-width:none;gap:1rem;flex-wrap:wrap">
        <div>
          <p class="cf-kicker">Mirada Fi</p>
          <h2>Nuestra <em>lectura</em> de la actualidad.</h2>
        </div>
        <a href={withBase("/mirada-fi")} class="cf-btn cf-btn-ghost">Ver todo</a>
      </div>
      <div class="cf-blog-layout">
        {
          featured && (
            <a href={withBase(`/mirada-fi/${featured.id}`)} class="cf-feature cf-reveal">
              {featured.data.cover && <img src={withBase(featured.data.cover)} alt={featured.data.title} />}
              <div class="cf-feature-grad"></div>
              <div class="cf-feature-body">
                <span class="cf-post-date" style="color:var(--cf-cyan)">{fmt(featured.data.pubDate)}</span>
                <h3>{featured.data.title}</h3>
                <p>{featured.data.description}</p>
              </div>
            </a>
          )
        }
        <div class="cf-post-list cf-reveal cf-d2">
          {
            rest.map((post) => (
              <a href={withBase(`/mirada-fi/${post.id}`)} class="cf-post-row">
                {post.data.cover ? (
                  <img src={withBase(post.data.cover)} alt={post.data.title} class="cf-post-thumb" />
                ) : (
                  <div class="cf-post-thumb" style="background:var(--cf-bg-soft)"></div>
                )}
                <div>
                  <span class="cf-post-date">{fmt(post.data.pubDate)}</span>
                  <h4>{post.data.title}</h4>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 8. CONVERSEMOS -->
  <CreativeCta />
  <CreativeFooter />
</CreativeLayout>

<script>
  // Banner Luz Verde: al entrar en pantalla se dibujan las líneas y el video
  // se reproduce una vez (termina en el logo). Con movimiento reducido queda el póster.
  const lv = document.getElementById("luz-verde");
  const video = lv?.querySelector("video");
  if (lv && video) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        lv.classList.add("cf-lv-on");
        if (!reduce) video.play().catch(() => {});
        io.disconnect();
      },
      { threshold: 0.35 }
    );
    io.observe(lv);
  }
</script>

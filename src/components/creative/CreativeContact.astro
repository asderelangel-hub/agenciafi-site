---
// Formulario + datos de contacto (página /contacto).
// El formulario envía a public/contact.php (mail() del hosting, sin servicios externos).
import { site } from "../../data/site";
import { withBase } from "../../lib/base";
---

<section class="cf-section" style="padding-top:1rem" id="contacto">
  <div class="cf-wrap cf-contact-grid">
    <form
      class="cf-form cf-contact-form cf-reveal"
      action={withBase("/contact.php")}
      method="POST"
      id="cf-contact-form"
    >
      <!-- Honeypots: invisibles para personas; si llegan con algo, es un bot -->
      <div class="cf-hp" aria-hidden="true">
        <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
        <input type="text" name="contact_extra" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="hp_elapsed" value="" />
      <input type="text" name="nombre" placeholder="Tu nombre" autocomplete="name" maxlength="80" required />
      <input type="email" name="email" placeholder="Tu email" autocomplete="email" maxlength="120" required />
      <input type="text" name="empresa" placeholder="Empresa u organización (opcional)" autocomplete="organization" maxlength="120" />
      <textarea name="mensaje" placeholder="Cuéntanos qué necesita tu organización" maxlength="3000" required></textarea>
      <button type="submit" class="cf-btn" style="justify-content:center">Enviar mensaje →</button>
      <p class="cf-form-status" role="status" aria-live="polite" hidden></p>
    </form>

    <aside class="cf-contact-info cf-reveal cf-d1">
      <div>
        <h3>Email</h3>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div>
        <h3>WhatsApp</h3>
        <a href={site.whatsapp} target="_blank" rel="noopener">{site.telefono}</a>
      </div>
      <div>
        <h3>Oficina</h3>
        <p>{site.direccion}</p>
      </div>
      <div>
        <h3>Redes</h3>
        <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={site.social.instagram} target="_blank" rel="noopener">Instagram ↗</a>
      </div>
    </aside>
  </div>
</section>

<script define:vars={{ fallbackEmail: site.email, fallbackPhone: site.telefono }}>
  const form = document.getElementById("cf-contact-form");
  if (form) {
    const started = Date.now();
    const status = form.querySelector(".cf-form-status");
    const button = form.querySelector('button[type="submit"]');
    const show = (text, ok) => {
      status.textContent = text;
      status.hidden = false;
      status.classList.toggle("is-ok", ok);
      status.classList.toggle("is-error", !ok);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      form.elements.hp_elapsed.value = String(Math.round((Date.now() - started) / 1000));
      button.disabled = true;
      const label = button.textContent;
      button.textContent = "Enviando…";
      status.hidden = true;
      try {
        const body = new FormData(form);
        const post = () => fetch(form.action, { method: "POST", body, headers: { Accept: "application/json" } });
        let res = await post();
        // HostGator responde 409 a los POST a .php sin su cookie anti-bot «humans_NNNN»
        // (las páginas HTML no la piden). Se guarda la cookie que indica y se reintenta una vez.
        if (res.status === 409) {
          const m = (await res.text()).match(/document\.cookie\s*=\s*"([^";]+)/);
          if (m) {
            document.cookie = `${m[1]}; path=/; SameSite=Lax`;
            res = await post();
          }
        }
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          form.reset();
          show("¡Gracias! Recibimos tu mensaje y te responderemos a la brevedad.", true);
        } else if (data.message === "invalid_email") {
          show("Revisa tu email: parece que no es válido.", false);
        } else {
          show(`No pudimos enviar tu mensaje. Escríbenos a ${fallbackEmail} o por WhatsApp al ${fallbackPhone}.`, false);
        }
      } catch {
        show(`No pudimos enviar tu mensaje. Escríbenos a ${fallbackEmail} o por WhatsApp al ${fallbackPhone}.`, false);
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
